{
  "name": "tck",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/tck/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run publish-if-not-exists",
        "cwd": "dist/libs/shared/tck"
      },
      "dependsOn": ["build"]
    },
    "pullSpec": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["git submodule update --init spec"],
        "cwd": "libs/shared/tck",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/shared/tck"],
      "dependsOn": ["pullSpec"],
      "options": {
        "jestConfig": "libs/shared/tck/jest.config.ts"
      }
    },
    "package": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["pullSpec"],
      "options": {
        "project": "libs/shared/tck/package.json",
        "outputPath": "dist/libs/shared/tck",
        "entryFile": "libs/shared/tck/src/index.ts",
        "tsConfig": "libs/shared/tck/tsconfig.lib.json",
        "compiler": "tsc",
        "generateExportsField": true,
        "umdName": "tck",
        "external": "all",
        "format": ["cjs", "esm"],
        "assets": [
          {
            "glob": "LICENSE",
            "input": "./",
            "output": "./"
          },
          {
            "glob": "README.md",
            "input": "./libs/shared/tck",
            "output": "./"
          },
          {
            "glob": "**/*",
            "input": "./libs/shared/tck/spec/specification/assets/provider-tck/gherkin",
            "output": "./features"
          },
          {
            "glob": "**/*",
            "input": "./libs/shared/tck/spec/specification/assets/provider-tck/flags",
            "output": "./flags"
          },
          {
            "glob": "**/*",
            "input": "./libs/shared/tck/spec/specification/assets/provider-tck/openapi",
            "output": "./openapi"
          }
        ]
      }
    }
  }
}
