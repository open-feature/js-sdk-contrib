# Maintainer-only live integration configuration.
# Contributors do not need an Optimizely account or this file.
# Use a Development or dedicated Staging environment SDK key.
OPTIMIZELY_SDK_KEY=

# Optional: only when the datafile endpoint requires authentication.
OPTIMIZELY_DATAFILE_ACCESS_TOKEN=

# Configure at least one typed flag for the live smoke test.
OPTIMIZELY_SMOKE_BOOLEAN_FLAG=
OPTIMIZELY_SMOKE_BOOLEAN_EXPECTED=
OPTIMIZELY_SMOKE_STRING_FLAG=
OPTIMIZELY_SMOKE_STRING_EXPECTED=
OPTIMIZELY_SMOKE_NUMBER_FLAG=
OPTIMIZELY_SMOKE_NUMBER_EXPECTED=
OPTIMIZELY_SMOKE_OBJECT_FLAG=
# JSON, for example: {"color":"blue"}
OPTIMIZELY_SMOKE_OBJECT_EXPECTED=

# Optional; defaults to a fixed, non-PII smoke-test identity.
OPTIMIZELY_SMOKE_TARGETING_KEY=

# An Optimizely REST/API token is not required by this provider.
